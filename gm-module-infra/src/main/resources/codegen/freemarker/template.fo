<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="invoice" page-height="297mm" page-width="210mm" margin="15mm">
            <fo:region-body margin-top="0mm" margin-bottom="0mm"/>
        </fo:simple-page-master>
    </fo:layout-master-set>

    <fo:page-sequence master-reference="invoice">
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="SimSun" font-size="10pt">

                <!-- 顶部标题 ZENITH -->
                <fo:block text-align="center" font-size="20pt" font-weight="bold" space-after="10mm">
                    ZENITH
                </fo:block>

                <!-- 头部信息表 -->
                <fo:table table-layout="fixed" width="100%" space-after="5mm">
                    <fo:table-column column-width="50%"/>
                    <fo:table-column column-width="50%"/>
                    <fo:table-body>
                        <fo:table-row background-color="#A0B2C6" height="8mm">
                            <fo:table-cell padding="5pt"><fo:block color="white" font-weight="bold">Recipient: ${recipient!}</fo:block></fo:table-cell>
                            <fo:table-cell padding="5pt" text-align="right"><fo:block color="white" font-weight="bold">Date: ${date!}</fo:block></fo:table-cell>
                        </fo:table-row>
                        <fo:table-row background-color="#A0B2C6" height="8mm">
                            <fo:table-cell padding="5pt"><fo:block color="white" font-weight="bold">Invoice No.: ${invoiceNo!}</fo:block></fo:table-cell>
                            <fo:table-cell padding="5pt" text-align="right"><fo:block color="white" font-weight="bold">Due Date: ${dueDate!}</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-body>
                </fo:table>

                <!-- 日期范围 -->
                <fo:block text-align="right" font-size="9pt" space-after="3mm">
                    Date Range : ${dateRange!}
                </fo:block>

                <!-- 明细数据表格 -->
                <fo:table table-layout="fixed" width="100%" border-collapse="collapse">
                    <fo:table-column column-width="10mm"/>
                    <fo:table-column column-width="60mm"/>
                    <fo:table-column column-width="20mm"/>
                    <fo:table-column column-width="25mm"/>
                    <fo:table-column column-width="20mm"/>
                    <fo:table-column column-width="15mm"/>
                    <fo:table-column column-width="25mm"/>

                    <!-- 表头 -->
                    <fo:table-header background-color="#1F4E79" color="white" font-weight="bold">
                        <fo:table-row height="8mm">
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>S/N</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>Product</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>Currency</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>Total</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>(USDT)</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>PT(%)</fo:block></fo:table-cell>
                            <fo:table-cell border="1.5pt solid black" padding="4pt" text-align="center"><fo:block>Total(USDT)</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-header>

                    <!-- 表体循环 -->
                    <fo:table-body>
                        <#list itemList as item>
                            <fo:table-row height="7mm">
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="center"><fo:block>${item.sn!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt"><fo:block>${item.product!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="center"><fo:block>${item.currency!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="right"><fo:block>${item.total!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="right"><fo:block>${item.usdt!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="center"><fo:block>${item.pt!}</fo:block></fo:table-cell>
                                <fo:table-cell border="0.5pt solid #D9D9D9" padding="4pt" text-align="right"><fo:block>${item.totalUsdt!}</fo:block></fo:table-cell>
                            </fo:table-row>
                        </#list>
                    </fo:table-body>
                </fo:table>

                <!-- 底部合计与说明 -->
                <fo:block space-before="5mm" font-size="8pt" color="#002060">
                    *Amount in USDT
                </fo:block>
                <fo:block font-size="8pt" color="#002060" space-after="5mm">
                    *The exchange rate is based on first day of subsequent month
                </fo:block>

                <!-- Subtotal 区域 -->
                <fo:table table-layout="fixed" width="100%">
                    <fo:table-column column-width="70%"/>
                    <fo:table-column column-width="15%"/>
                    <fo:table-column column-width="15%"/>
                    <fo:table-body>
                        <fo:table-row>
                            <fo:table-cell><fo:block/></fo:table-cell>
                            <fo:table-cell background-color="#1F4E79" padding="4pt"><fo:block color="white" font-weight="bold">Subtotal</fo:block></fo:table-cell>
                            <fo:table-cell background-color="#1F4E79" padding="4pt" text-align="right"><fo:block color="white" font-weight="bold">${subtotal!}</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-body>
                </fo:table>

                <!-- 汇率小表格 -->
                <fo:table table-layout="fixed" width="40mm" space-before="5mm" border-collapse="collapse">
                    <fo:table-column column-width="20mm"/>
                    <fo:table-column column-width="20mm"/>
                    <fo:table-header background-color="#1F4E79">
                        <fo:table-row height="6mm">
                            <fo:table-cell border="0.5pt solid black" padding="2pt" text-align="center"><fo:block color="white" font-weight="bold">Exchange rate</fo:block></fo:table-cell>
                            <fo:table-cell border="0.5pt solid black" padding="2pt" text-align="center"><fo:block color="white" font-weight="bold">USDT</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-header>
                    <fo:table-body>
                        <fo:table-row height="6mm">
                            <fo:table-cell border="0.5pt solid #D9D9D9" padding="2pt" text-align="center"><fo:block>INR</fo:block></fo:table-cell>
                            <fo:table-cell border="0.5pt solid #D9D9D9" padding="2pt" text-align="right"><fo:block>${exchangeRate!}</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-body>
                </fo:table>

            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>